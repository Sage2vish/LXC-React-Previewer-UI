{
  "name": "lxc-react-previewer-ui",
  "displayName": "LXC React Previewer UI",
  "description": "Preview a React Native .tsx screen beside its source in VS Code.",
  "version": "0.1.3",
  "publisher": "Sage2vish",
  "icon": "assets/icons-all-size/icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sage2vish/LXC-React-Previewer-UI.git"
  },
  "bugs": {
    "url": "https://github.com/Sage2vish/LXC-React-Previewer-UI/issues"
  },
  "homepage": "https://github.com/Sage2vish/LXC-React-Previewer-UI#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "react-native",
    "preview",
    "tsx",
    "webview",
    "vscode-extension"
  ],
  "activationEvents": [
    "onCommand:lxcReactPreviewer.openPreview",
    "onCommand:lxcReactPreviewer.refreshPreview",
    "onCommand:lxcReactPreviewer.selectFrameworksFolder"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lxcReactPreviewer.openPreview",
        "title": "Open with LXC React UI Previewer"
      },
      {
        "command": "lxcReactPreviewer.refreshPreview",
        "title": "Refresh Preview",
        "icon": "$(refresh)"
      },
      {
        "command": "lxcReactPreviewer.selectFrameworksFolder",
        "title": "Select Frameworks Folder",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lxcReactPreviewer.openPreview",
          "icon": "$(eye)",
          "when": "resourceExtname == .tsx",
          "group": "navigation@1"
        },
        {
          "command": "lxcReactPreviewer.refreshPreview",
          "icon": "$(refresh)",
          "when": "resourceExtname == .tsx",
          "group": "navigation@2"
        },
        {
          "command": "lxcReactPreviewer.selectFrameworksFolder",
          "icon": "$(settings-gear)",
          "when": "resourceExtname == .tsx",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "lxcReactPreviewer.openPreview"
        },
        {
          "command": "lxcReactPreviewer.refreshPreview"
        },
        {
          "command": "lxcReactPreviewer.selectFrameworksFolder"
        }
      ],
      "explorer/context": [
        {
          "command": "lxcReactPreviewer.openPreview",
          "when": "resourceExtname == .tsx",
          "group": "navigation@1"
        },
        {
          "command": "lxcReactPreviewer.refreshPreview",
          "when": "resourceExtname == .tsx",
          "group": "navigation@2"
        }
      ],
      "statusBar/window": [
        {
          "command": "lxcReactPreviewer.selectFrameworksFolder",
          "when": "workspaceFolderCount > 0",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "watch": "tsc -w -p ./tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --test out/test/**/*.test.js",
    "package": "echo \"Package by zipping the extension contents into a .vsix\""
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.3"
  }
}
